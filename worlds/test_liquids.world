version: 1
name: Liquid Test
half: 95.0
runway: -6.00 -6.00 6.00 6.00

# FOUR POOLS, ONE PER `wf.Liquid`, on bare ground, each 14 m across at (+/-32, +/-32):
#   -x -z water (nothing)    +x -z oil (nothing)
#   -x +z fungal (POISON)    +x +z lava (BURNING, and it bites)
# --shot-land --map worlds/test_liquids.world, or `--map` it and walk in.
# The four are the SAME pool in every respect but their look, their status and their voice: same coast, same
# depth, same wading, same gate. Anything that reads differently between two of them is the bug.

zone: bare -400.0 -400.0 400.0 400.0 0.000 tuft
clear: 0.0 0.0 400.0

at: bonfire 0 -2 0 1

# Four stones in the corners and nothing else - a map in worlds/ has to materialize something (env's own
# shipped-map test), and the corners are the one place they cannot crowd a coast.
at: boulder -86 -86 20 1.4
at: boulder 86 -86 130 1.2
at: boulder -86 86 250 1.3
at: boulder 86 86 310 1.5
