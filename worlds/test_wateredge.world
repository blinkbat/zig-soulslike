version: 1
name: Water Edge Test
half: 95.0
runway: -6.00 -6.00 6.00 6.00

# EIGHT PONDS, ONE PER `wf.Edge`, LEFT TO RIGHT THEN TOP TO BOTTOM:
# 0 blend  1 natural  2 frayed  3 jagged  4 straight  5 tiled  6 scallop  7 speckle
# Bare ground on purpose - nothing planted, so the only thing in frame is the coast.

zone: bare -400.0 -400.0 400.0 400.0 0.000 tuft
clear: 0.0 0.0 400.0

# FOUR STONES IN THE CORNERS AND NOTHING ELSE - a map in worlds/ has to materialize something
# (env's own shipped-map test), and the corners are the one place they cannot crowd a coast.
at: boulder -86 -86 20 1.4
at: boulder 86 -86 130 1.2
at: boulder -86 86 250 1.3
at: boulder 86 86 310 1.5
