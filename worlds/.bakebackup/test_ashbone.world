version: 1
name: The Ribs in the Ashfall
half: 96.0
runway: -4.00 -10.00 4.00 12.00

# THE RIBS IN THE ASHFALL — the two ideas are one place. What died here is the reason for the ash and the
# ash is the reason you can still see what died. He starts at (0, 4) facing SOUTH (game.beginGame plants
# every hero there), so the whole carcass is laid out down -Z from the spawn: gate, avenue, skull.

zone: ashfall -400.0 -400.0 400.0 400.0 0.260 cinders,cinders,cinders,ashheap,bracken,thistle,rubble
zone: scoured -400.0 -400.0 400.0 -70.0 0.110 cinders,cinders,ashheap
# …and the opposite: a place it never rains. `wet=0` is an OPINION, where no location at all would leave the
# world's storm clock free to soak the ashfall.
location: burnt -96.0 -96.0 96.0 96.0 wet=0.000 fog=0.120 blend=12.00

clear: 0.0 -34.0 16.0
cover: 4.20 0.75 1.30 seed=7001

