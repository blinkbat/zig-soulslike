at: rib3 -7.4 -54 86 1.10
at: rib2 7.4 -56.4 262 1.02
at: rib2 -8.2 -62 92 0.92
at: rib 8.2 -64.4 255 0.88

# …AND THE ONES THAT CAME DOWN. A cage with every rib still standing is a fence.
at: rib2 -13.5 -26.0 38 0.80
at: rib3 15.2 -44.0 212 0.72
at: rib 12.0 -57.0 300 0.66

