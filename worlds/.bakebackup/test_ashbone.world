# THE GATE. A rib arch is the only doorway in the world nobody built — 9.1 m of span on a 5.1 m crown,
# both measured off `propbone.ribPath` rather than typed, so it is a semicircle and reads as one.
at: ribarch 0 -14 0 1
at: vertebra -6.4 -13.2 24 1.1
at: vertebra 6.9 -14.6 -50 0.95

# THE AVENUE. Pairs down the spine line, ALTERNATING the three kinds either side — wabi-sabi BETWEEN the
# instances, never along one, so no two facing ribs are the same rib and the run never bands.
at: rib -7.6 -22 80 0.92
at: rib2 7.6 -24.4 269 0.88
at: rib3 -8.4 -30 86 1.04
at: rib 8.4 -32.4 262 1.09
