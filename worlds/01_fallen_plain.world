flags: met_wanderer heard_of_gate

npc: wanderer -4.50 7.50 128.0 1.00 0.31 roam=1.8 dlg=wanderer
  call: The Wanderer

dlg: wanderer
  node: root
  say: Another one walking north, and the road only goes the one way after that.
  ask: What lies north? -> north
  ask: Then why do you sit here? -> why
  need: flag heard_of_gate=1
  ask: (say nothing) -> end
  node: north
  say: A gate the size of a hill, and shut since before I came. Whatever closed it is still on this side of it.
  act: flag heard_of_gate=1
  then: root
  node: why
  say: Sit long enough at a fire and the road stops asking.
  then: root

trig: wanderer_seen pri=10
  when: near npc=0 r=3.5
  when: flag met_wanderer=0
  do: flag met_wanderer=1
  do: text Someone is sitting at the bonfire.
trig: gate_rumour
  when: talked wanderer
  when: flag heard_of_gate=1
  do: wait 1
  do: text The way north is shut.
trig: the_avenue
  when: region -12.0 -40.0 12.0 -12.0
  do: text Smoldering Ruins
trig: toads_thinned
  when: deaths toad >= 3
  do: text The bog is quieter.
