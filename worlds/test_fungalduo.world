version: 1
name: Fungal Duo Test
half: 74.0
runway: -6.00 -30.00 6.00 -18.00

# THE PAIR, ON AN ARENA FLOOR WITH ONE PILLAR IN IT. Nothing here but the fight: the point of the bench is
# whether the two BANDS work against each other, and a wood would hide the half of it that is spacing.
# The pillar is there so the magus has one thing to break line with and the swordsman one thing to corner you on.
#   --map worlds/test_fungalduo.world

zone: myc -400.0 -400.0 400.0 400.0 0.340 moss,moss,mushrooms,sporepod,clover,bracken
clear: 0.0 0.0 40.0

at: bonfire -2 -28 0 1
at: chest 4.0 -26 190 1 loot=purgeleaf,empty_flask,wax_stopped_hood
at: chest -6.0 -26.5 170 1 loot=nightcap_grease,pilgrims_salt,empty_flask

# THE ARENA MOUTH. The gate names BOTH bodies, which is what a duo needs and what the seal list is for: it
# holds while either of them stands, and neither BOSS BAR comes up until he has walked through it. Walled to
# either side so the door is the way in and not one option among two - a gate you can stroll round proves
# nothing about a gate.
at: foggate 0 -12 0 2.4 boss=fungal_swordsman,fungal_magus
at: wall -6.2 -12 0 1.0
at: wall 6.2 -12 0 1.0
at: cliff6 -16 -13 0 1.0
at: cliff6 16 -13 0 1.0

# THE ROOM ITSELF, and the gate above is only its door. Walled at the mouth alone the arena was OPEN GROUND:
# you could stroll round the sheet and the magus dissolved straight out of the fight. The seal is the same pair
# the gate names, and the polygon takes in the mouth so the crossing lands you inside your own wall.
arena: mycelian_hall boss=fungal_swordsman,fungal_magus -26.0 -12.0 26.0 -12.0 30.0 12.0 20.0 30.0 -20.0 30.0 -30.0 12.0

at: pillar 0 6 0 1.3
at: boulder -16 -4 20 1.4
at: boulder 15 -2 130 1.2
at: boulder -13 18 250 1.1
at: boulder 14 17 310 1.3
at: capgiant -26 -14 40 1.0
at: capgiant 25 12 200 1.1
at: glowcluster -20 8 0 1.0
at: glowcluster 19 -12 0 1.0

# **THE SWORDSMAN STANDS IN FRONT AND THE MAGUS BEHIND HIM**, at the distance the pair are meant to hold: he is
# inside his own lunge band of the runway and it is out past its flee ring, so the opening of the fight is the
# shape the whole fight keeps.
foe: fungal_swordsman 0.00 -4.00 180.0 1.00 0.30
foe: fungal_magus 0.00 14.00 180.0 1.00 0.70
