version: 1
name: The Mycelian
half: 88.0
runway: -4.00 -8.00 4.00 12.00

# THE MYCELIAN — a wood with no wood in it. All THREE layers a region owes are fungal (great caps for
# canopy, clusters and brackets for understorey, pods and moss on the floor), which is what stops it
# reading as a forest that had its trees swapped out. The only real lights in it are the glowcaps, so it
# holds its look at any hour: walk OUT of it at dusk and that is when you notice.

zone: myc -400.0 -400.0 400.0 400.0 0.880 sporepod,sporepod,sporepod,moss,moss,moss,mushrooms,mushrooms,clover,bracken,fern
zone: thin -400.0 -400.0 -46.0 400.0 0.420 moss,mushrooms,sporepod,clover
# A WEATHER REGION. The mushroom wood keeps its own air: half-wet and thick with it, cross-faded over 8 s as
# you walk in. There is one sky, so this drives the global level while he is inside rather than raining only
# here — walking into the murk, not looking at it from outside.
location: bloom -34.0 -66.0 34.0 8.0 spore=0.850 fog=0.180 blend=8.00
location: fringe -80.0 -80.0 80.0 80.0 spore=0.300 fog=0.220 blend=10.00

