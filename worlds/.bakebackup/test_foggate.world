# THE FOG GATES — three sizes and three yaws, which is the whole of what the editor gives an `at` op.
at: foggate 0.00 6.00 0 1.00
at: foggate -14.00 -6.00 35 1.60
at: foggate 13.00 -7.00 300 0.65

# …and one standing in somebody else's archway, which is what it is for.
at: arch 0.00 -14.00 0 1.10
at: foggate 0.00 -14.00 0 1.35

# WHAT MAY NOT FOLLOW HIM IN — a warband and a skeleton line on the far bank.
foe: berserker -4.00 16.00 180.0 1.00 0.21
foe: slinger 2.50 18.00 180.0 1.00 0.63
foe: priest -1.00 20.50 180.0 1.00 0.88
foe: greatsword 8.00 17.00 190.0 1.00 0.44
foe: archer -10.00 19.00 170.0 1.00 0.12

# …AND WHAT MAY. The toad is a beast that likes water; the lurker lives in it.
foe: toad -6.00 1.00 0.0 1.05 0.31
foe: fen_lurker 6.00 -1.00 180.0 1.00 0.55
foe: fen_lurker -16.00 2.00 90.0 1.00 0.77

# The dirk and the club, so the swing, the reach and the HUD cell can be compared against the plain sword.
at: chest -3.00 -24.00 0 1 loot=fang_dirk,greatclub,grave_warbow
at: chest 3.00 -24.00 0 1 loot=tower_shield,quilted_gambeson,leech_signet
at: bonfire 0.00 -27.00 0 1

at: boulder -11.00 -11.00 20 1.3
at: snag 17.00 -13.00 0 1
