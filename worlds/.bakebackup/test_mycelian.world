# THE UNDERSTOREY, and it is a SCATTER rather than a row — clusters where the mat is thick, brackets
# wherever there was something dead to stand on.
belt: capcluster -70 -70 70 70 40 0.75 1.35 seed=8002
belt: bracket -70 -70 70 70 26 0.80 1.30 seed=8003
belt: rotlog -68 -68 68 68 14 0.85 1.25 seed=8004
belt: deadfall -68 -68 68 68 11 0.80 1.20 seed=8005

# THE LIGHT. Every one of these carries a real 7.5 m pool, so they are placed to POOL rather than to wash:
# spaced further apart than two radii, and set off the path rather than on it.
